# Salin berkas ini menjadi .env untuk mencoba di komputer sendiri.
# JANGAN pernah commit .env ke GitHub.
#
# Di Cloudflare, nilai-nilai ini TIDAK diambil dari .env. Isi lewat dashboard:
#   Workers & Pages > project > Settings > Variables and Secrets
# Yang berisi rahasia (empat baris pertama di bawah) pilih tipe "Secret",
# bukan "Text", supaya nilainya tidak bisa dibaca lagi setelah disimpan.

# --- Rahasia -------------------------------------------------------------

# Database Neon. Ambil dari console.neon.tech > project > Connect.
# Pakai connection string yang "Pooled connection".
# Kosongkan untuk mencoba tanpa Neon (data disimpan di memori dan hilang
# setiap server dimatikan).
DATABASE_URL=

# Token bot Telegram dari @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Kata sandi untuk masuk ke /admin.html
ADMIN_PASSWORD=

# Kunci acak penanda tangan token sesi. Buat dengan:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# --- Pengaturan biasa ----------------------------------------------------

# ID chat admin Telegram. Cara mendapatkannya ada di README.
# Boleh beberapa, dipisah koma. ID grup berupa angka negatif.
TELEGRAM_CHAT_ID=

# Alamat publik situs, dipakai untuk tombol di notifikasi Telegram.
URL_PUBLIK=https://masgaluh.smpn30smg.online

ZONA_WAKTU=Asia/Jakarta
SESI_UMUR_JAM=12

# --- Pembatas laju (opsional) --------------------------------------------
# Semua per alamat IP. Naikkan BATAS_KIRIM kalau banyak warga mengirim dari
# wifi sekolah yang sama, karena mereka akan terlihat ber-IP sama.
BATAS_KIRIM=5
BATAS_CEK_STATUS=30
BATAS_LOGIN=8
